# Existing boom-bot commands
TELEGRAM_TOKEN=
TELEGRAM_TOKEN_DEV=

# Chess Challenge
# Local default is ./data; Fly sets BOT_DATA_DIR and CHESS_DATABASE_PATH to /data.
# BOT_DATA_DIR=/data
# CHESS_DATABASE_PATH=/data/chess.sqlite3
STOCKFISH_PATH=stockfish
STOCKFISH_HASH_MB=64
STOCKFISH_THREADS=1
STOCKFISH_DEPTH=12
# Override game and post-game analysis independently when needed.
# STOCKFISH_GAME_DEPTH=12
# STOCKFISH_ANALYSIS_DEPTH=12
CHESS_ANALYSIS_INTERVAL=15

# Existing LLM commands
LLM_API_KEY=
LLM_MODELS=openrouter/free
