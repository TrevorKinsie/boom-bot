# boom-bot environment (read by bot-cpp/build/boombot, the C++20 Telegram bot).
# The Python casino (boombot.casino) was retired; only the chess engine
# (boombot/games/chess) remains Python-side and it is not yet wired into the
# C++ bot.

# Telegram bot token. The C++ bot reads TELEGRAM_TOKEN (TELEGRAM_TOKEN_DEV on
# Windows, matching the previous Python behaviour).
TELEGRAM_TOKEN=

# --- Chess Challenge (Python, unported) ---
# Local default is ./data; Fly sets BOT_DATA_DIR and CHESS_DATABASE_PATH to /data.
# BOT_DATA_DIR=/data
# CHESS_DATABASE_PATH=/data/chess.sqlite3
STOCKFISH_PATH=stockfish
STOCKFISH_HASH_MB=64
STOCKFISH_THREADS=1
STOCKFISH_DEPTH=12
# Override game and post-game analysis independently when needed.
# STOCKFISH_GAME_DEPTH=12
# STOCKFISH_ANALYSIS_DEPTH=12
CHESS_ANALYSIS_INTERVAL=15
# Comma-separated Telegram user IDs allowed to receive full chess error logs.
# Set this as the CHESS_ERROR_LOG_USER_IDS repository/runtime secret.
# CHESS_ERROR_LOG_USER_IDS=123456,789012

# --- LLM commands (/whowouldwin, /friggedthedeposit) ---
LLM_API_KEY=
LLM_MODELS=openrouter/free
# When a 404 names a replacement slug, retry it (normally the paid model).
# LLM_FOLLOW_MODEL_HINTS=false
# LLM_TIMEOUT=30
# LLM_REFERER=
# LLM_APP_NAME=boom-bot

# --- Enterprise casino (event-sourced wallet, C++20) ---
# Backing event store: sqlite | json. The C++20 bot implements the JSON store
# (JSONL log + per-aggregate snapshots); the SQLite path is used by the MMO's
# legacy shared store, not by the current wallet.
# CASINO_STORAGE=json
# CASINO_EVENT_STORE_JSON=<DATA_DIR>/casino_events.json
# CASINO_EVENT_STORE_SQLITE=<DATA_DIR>/casino.sqlite3
# CASINO_SNAPSHOT_THRESHOLD=50
# CASINO_STARTING_BALANCE=100.00
# CASINO_CURRENCY_QUANTIZATION=0.01
# ZEUS_SPIN_COST=10.00
# LEADERBOARD_SIZE=10

# --- JVM Decision Engine (decision-engine/) ---
# The C++20 port renders casino outcomes in-process (reference provider); the
# JVM/Rust engine remains a standalone JSON-lines decision fabric and is still
# built into the Docker image. These vars are parsed by bb_config for
# compatibility.
# DECISION_ENGINE_MODE=auto
# DECISION_ENGINE_JAR=decision-engine/build/jvm-decision-engine.jar
# DECISION_ENGINE_RUST_BIN=decision-engine/build/atomic_cli
# DECISION_ENGINE_TIMEOUT_SECONDS=5

# --- MMO game service (mmo-server/, Java) ---
# MMO_BIND=0.0.0.0
# MMO_PORT=8080
# MMO_GAME_DB=/data/mmo.sqlite3
# MMO_WALLET_DB=/data/casino.sqlite3
