# Existing boom-bot commands
TELEGRAM_TOKEN=
TELEGRAM_TOKEN_DEV=

# Chess Challenge
# Local default is ./data; Fly sets BOT_DATA_DIR and CHESS_DATABASE_PATH to /data.
# BOT_DATA_DIR=/data
# CHESS_DATABASE_PATH=/data/chess.sqlite3
STOCKFISH_PATH=stockfish
STOCKFISH_HASH_MB=64
STOCKFISH_THREADS=1
STOCKFISH_DEPTH=12
# Override game and post-game analysis independently when needed.
# STOCKFISH_GAME_DEPTH=12
# STOCKFISH_ANALYSIS_DEPTH=12
CHESS_ANALYSIS_INTERVAL=15
# Comma-separated Telegram user IDs allowed to receive full chess error logs.
# Set this as the CHESS_ERROR_LOG_USER_IDS repository/runtime secret.
# CHESS_ERROR_LOG_USER_IDS=123456,789012

# Existing LLM commands
LLM_API_KEY=
LLM_MODELS=openrouter/free

# JVM Decision Engine
# The decision fabric delegates game outcomes to the JVM decision engine,
# which asks the Rust atomic-logic layer for pure randomness. Build it with
# `./decision-engine/build.sh`. Mode: auto | jvm | reference.
# DECISION_ENGINE_MODE=auto
# DECISION_ENGINE_JAR=decision-engine/build/jvm-decision-engine.jar
# DECISION_ENGINE_RUST_BIN=decision-engine/build/atomic_cli
# DECISION_ENGINE_TIMEOUT_SECONDS=5
